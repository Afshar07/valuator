<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ProjectOperations.Desktop.Common"
             xmlns:shell="using:ProjectOperations.Desktop.Shell"
             x:Class="ProjectOperations.Desktop.Shell.NavItemView"
             x:DataType="shell:NavItemViewModel">
  <Button Name="NavButton" Classes="nav" Classes.selected="{Binding IsSelected}" IsVisible="{Binding IsVisible}"
          Command="{Binding NavigateCommand}" AutomationProperties.Name="{Binding Title}">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
      <c:IconGlyph Icon="{Binding Icon}" Size="16" Token="{Binding IconToken}" />
      <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Border Name="NewBadge" IsVisible="{Binding IsNew}" Padding="7,1" CornerRadius="99" Background="{DynamicResource AccentSoftBrush}">
          <TextBlock Classes="Micro" FontWeight="SemiBold" TextWrapping="NoWrap" Foreground="{DynamicResource AccentTextBrush}" Text="{Binding L[v3.newBadge]}" />
        </Border>
        <Border IsVisible="{Binding HasCount}" MinWidth="18" Height="18" Padding="5,0" CornerRadius="9" VerticalAlignment="Center" Background="{DynamicResource ErrorSoftBrush}">
          <TextBlock Classes="Micro" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ErrorBrush}" Text="{Binding CountText}" />
        </Border>
      </StackPanel>
    </Grid>
  </Button>
</UserControl>
