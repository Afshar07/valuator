<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ProjectOperations.Desktop.Common"
             xmlns:app="using:ProjectOperations.Desktop"
             xmlns:shell="using:ProjectOperations.Desktop.Shell"
             x:Class="ProjectOperations.Desktop.Shell.SampleBannerView"
             x:DataType="shell:SampleBannerViewModel">
  <!-- Dashed outline: this is not the user's data. -->
  <Panel>
    <Border CornerRadius="10" Padding="14,10" Background="{DynamicResource BackgroundCardBrush}">
      <Grid Name="SampleBanner" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <c:IconGlyph Icon="{x:Static app:Icons.Flask}" Size="17" Token="TextSecondary" />
        <TextBlock Grid.Column="1" Classes="Small" VerticalAlignment="Center"><Run Text="{Binding L[v3.sampleBanner]}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding L[v3.sampleNote]}" Foreground="{DynamicResource TextSecondaryBrush}" /></TextBlock>
        <Button Grid.Column="2" Name="StartMine" Classes="primary" MinHeight="30" HorizontalAlignment="Left" Command="{Binding StartMineCommand}" Content="{Binding L[v3.startMine]}" />
      </Grid>
    </Border>
    <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="1" StrokeDashArray="4,3" IsHitTestVisible="False" Stroke="{DynamicResource BorderDefaultBrush}" />
  </Panel>
</UserControl>
