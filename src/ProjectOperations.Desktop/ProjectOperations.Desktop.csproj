<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets/Icons/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/Fonts/**/*.ttf" />
    <AvaloniaResource Include="Assets/Icons/app.ico;Assets/Icons/*.png" />
    <EmbeddedResource Include="Localization/Resources/*.json" WithCulture="false" />
    <InternalsVisibleTo Include="ProjectOperations.Desktop.Tests" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <ProjectReference Include="../ProjectOperations.Core/ProjectOperations.Core.csproj" />
    <ProjectReference Include="../ProjectOperations.Infrastructure/ProjectOperations.Infrastructure.csproj" />
  </ItemGroup>
</Project>
