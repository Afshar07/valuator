<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:ProjectOperations.Desktop.Common"
        xmlns:app="using:ProjectOperations.Desktop">
  <Styles.Resources>
    <!-- Modal dialog chrome. Colours and shadows are theme tokens registered by PresentationTheme, so Light/Dark switch live. -->
    <ControlTheme x:Key="{x:Type c:DialogChrome}" TargetType="c:DialogChrome">
      <Setter Property="Width" Value="480" />
      <Setter Property="MaxWidth" Value="480" />
      <Setter Property="Margin" Value="16" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{DynamicResource BackgroundCardBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                  BorderThickness="1" CornerRadius="14" BoxShadow="{DynamicResource RaisedShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="18,16,18,4">
                  <TextBlock Classes="Dialog" Text="{TemplateBinding Title}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="icon" Command="{TemplateBinding CloseCommand}"
                          AutomationProperties.Name="{TemplateBinding CloseLabel}" ToolTip.Tip="{TemplateBinding CloseLabel}">
                    <c:IconGlyph Icon="{x:Static app:Icons.X}" Size="15" />
                  </Button>
                </Grid>
                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

  <!-- Button row under a dialog body. -->
  <Style Selector="Border.dialogFooter">
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="Padding" Value="18,12" />
  </Style>

  <!-- Card: the white rounded surface lists and sections sit on. -->
  <Style Selector="Border.card">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="{DynamicResource BackgroundCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
  </Style>

  <!-- The rule above a list row; the first row of a card without a heading has none. -->
  <Style Selector="Border.rule">
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
  </Style>
  <Style Selector="Border.rule.first">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Small marker beside an entry: a circle, a square for milestones, red when late, quiet grey for another calendar's events. -->
  <Style Selector="Border.dot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="Border.dot.milestone">
    <Setter Property="CornerRadius" Value="1.5" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.dot.external">
    <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.dot.overdue">
    <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
  </Style>
</Styles>
