<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:ProjectOperations.Desktop.Common"
        xmlns:app="using:ProjectOperations.Desktop"
        xmlns:shell="using:ProjectOperations.Desktop.Shell"
        x:Class="ProjectOperations.Desktop.MainWindow"
        x:DataType="shell:MainWindowViewModel"
        Title="{Binding L[app.title]}"
        Icon="avares://ProjectOperations.Desktop/Assets/Icons/app.ico"
        Width="1280" Height="860" MinWidth="800" MinHeight="600"
        FlowDirection="{Binding L.FlowDirection}"
        FontFamily="{Binding L.IsRightToLeft, Converter={x:Static c:PresentationConverters.UiFont}}"
        RequestedThemeVariant="{Binding ThemeId, Converter={x:Static c:PresentationConverters.Theme}}">
  <Grid Name="Shell" ColumnDefinitions="Auto,*,Auto">
    <Border Name="SidebarHost" IsEnabled="{Binding IsSidebarEnabled}">
      <ContentControl Content="{Binding Sidebar}" />
    </Border>

    <DockPanel Name="WorkspaceBody" Grid.Column="1">
      <Border Name="ErrorBanner" DockPanel.Dock="Top" IsVisible="{Binding HasError}" Padding="14,8,8,8" Margin="32,16,32,0" BorderThickness="1" CornerRadius="10"
              Background="{DynamicResource ErrorSoftBrush}" BorderBrush="{DynamicResource ErrorBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <c:IconGlyph Icon="{x:Static app:Icons.WarningCircle}" Size="17" Token="Error" VerticalAlignment="Top" Margin="0,1,0,0" />
          <TextBlock Grid.Column="1" Classes="Small" VerticalAlignment="Center" Text="{Binding ErrorText}" />
          <Button Grid.Column="2" Classes="icon" VerticalAlignment="Top" Command="{Binding DismissErrorCommand}" AutomationProperties.Name="{Binding L[action.close]}">
            <c:IconGlyph Icon="{x:Static app:Icons.X}" Size="14" Token="TextSecondary" />
          </Button>
        </Grid>
      </Border>

      <ContentControl Name="ScreenHost" IsEnabled="{Binding IsPageEnabled}">
        <ScrollViewer Name="PageScroll" HorizontalScrollBarVisibility="Disabled">
          <c:ReadableColumn>
            <Border Padding="32,28,32,40">
              <StackPanel Spacing="20">
                <ContentControl Content="{Binding SampleBanner}" IsVisible="{Binding HasSampleBanner}" />
                <ContentControl Content="{Binding Page}" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Border>
          </c:ReadableColumn>
        </ScrollViewer>
      </ContentControl>
    </DockPanel>

    <!-- The assistant at the end edge. The window decides whether it docks beside the page or overlays it (see PlaceAssistant). -->
    <Border Name="AssistantPanel" Grid.Column="2" Width="360" IsVisible="{Binding IsAssistantOpen}" BorderThickness="1,0,0,0"
            Background="{DynamicResource BackgroundCardBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}">
      <ContentControl Content="{Binding Assistant}" />
    </Border>

    <Panel Name="DialogLayer" Grid.ColumnSpan="3" ZIndex="10" IsVisible="{Binding Dialogs.IsOpen}">
      <Border Name="Scrim" Background="{DynamicResource ScrimBrush}" PointerPressed="OnScrimPressed" />
      <ContentControl Content="{Binding Dialogs.Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Panel>

    <Panel Name="OnboardingOverlay" Grid.ColumnSpan="3" ZIndex="30" IsVisible="{Binding HasOverlay}">
      <ContentControl Content="{Binding Overlay}" />
    </Panel>

    <Border Name="Toast" Grid.ColumnSpan="3" ZIndex="40" IsVisible="{Binding HasToast}" IsHitTestVisible="False" MaxWidth="540" Padding="14,10" CornerRadius="10"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20,0,20,20" Background="{DynamicResource TextPrimaryBrush}" BoxShadow="{DynamicResource RaisedShadow}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <c:IconGlyph Icon="{x:Static app:Icons.Info}" Weight="Fill" Size="16" Token="BackgroundApp" />
        <TextBlock Name="ToastText" Classes="Small" VerticalAlignment="Center" Foreground="{DynamicResource BackgroundAppBrush}" Text="{Binding ToastText}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
