<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ProjectOperations.Desktop.Common"
             xmlns:app="using:ProjectOperations.Desktop"
             xmlns:vm="using:ProjectOperations.Desktop.Features.Assistant"
             x:Class="ProjectOperations.Desktop.Features.Assistant.ProposalReviewView"
             x:DataType="vm:ProposalReviewViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.due">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.due.late">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="12">
    <!-- The tray: violet, because these are the agent's suggestions and not project data. -->
    <Border Name="ProposalTray" CornerRadius="10" BorderThickness="1" ClipToBounds="True"
            Background="{DynamicResource AiSoftBrush}" BorderBrush="{DynamicResource AiBorderBrush}">
      <StackPanel>
        <Border Padding="12,10">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
            <c:IconGlyph Icon="{x:Static app:Icons.Sparkle}" Weight="Fill" Size="13" Token="Ai" />
            <TextBlock Grid.Column="1" Classes="CaptionMedium" FontWeight="SemiBold" Foreground="{DynamicResource AiBrush}" Text="{Binding TrayTitle}" />
            <TextBlock Grid.Column="2" Classes="Micro" FontWeight="Normal" VerticalAlignment="Center" TextWrapping="NoWrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding L[proposal.notCommitted]}" />
          </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProposalItemViewModel">
              <Border Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AiBorderBrush}">
                <c:AiCheckBox IsEnabled="{Binding IsEnabled}" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                  <TextBlock Classes="Small" Text="{Binding Text}" />
                </c:AiCheckBox>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Padding="12,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AiBorderBrush}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <Button Classes="primary" HorizontalAlignment="Stretch" IsEnabled="{Binding CanReview}" Command="{Binding ApproveCommand}" Content="{Binding L[proposal.addSelected]}" />
            <Button Grid.Column="1" IsEnabled="{Binding CanReview}" Command="{Binding RejectCommand}" Content="{Binding L[proposal.rejectSelected]}" />
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <StackPanel Name="CommittedTasks" Spacing="4">
      <TextBlock Classes="Caption" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding L[proposal.committed]}" />
      <TextBlock Classes="Small" Foreground="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding HasNoCommittedTasks}" Text="{Binding L[presentation.noActiveTasks]}" />
      <ItemsControl ItemsSource="{Binding CommittedTasks}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CommittedTaskViewModel">
            <Border Padding="10,8" BorderThickness="1" CornerRadius="8" Background="{DynamicResource BackgroundCardBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <c:IconGlyph Icon="{x:Static app:Icons.Circle}" Size="14" Token="TextTertiary" />
                <TextBlock Grid.Column="1" Classes="BodyMedium" Text="{Binding Title}" />
                <TextBlock Grid.Column="2" Classes="Caption due" Classes.late="{Binding IsLate}" VerticalAlignment="Center" Text="{Binding DueText}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
