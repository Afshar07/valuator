<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ProjectOperations.Desktop.Common"
             xmlns:app="using:ProjectOperations.Desktop"
             xmlns:shell="using:ProjectOperations.Desktop.Shell"
             x:Class="ProjectOperations.Desktop.Features.Onboarding.OnboardingTopBar"
             x:DataType="shell:DisplayOptionsViewModel">
  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="20,16">
    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
      <Image Width="30" Height="30" Stretch="Uniform" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality"
             AutomationProperties.AccessibilityView="Raw" Source="avares://ProjectOperations.Desktop/Assets/Icons/app-icon-512.png" />
      <TextBlock Classes="BodyStrong" VerticalAlignment="Center" Text="{Binding L[app.title]}" />
    </StackPanel>
    <Border Grid.Column="1" Name="OnboardingTheme" Classes="segmented" VerticalAlignment="Center">
      <ItemsControl ItemsSource="{Binding Theme.Options}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="c:ChipOptionViewModel">
            <Button Classes="segment" Classes.selected="{Binding IsSelected}" Margin="1,0" MinWidth="56" Command="{Binding SelectCommand}"
                    Content="{Binding Label}" AutomationProperties.Name="{Binding Label}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
    <Button Grid.Column="2" Name="OnboardingLanguage" Height="32" MinHeight="32" Padding="10,0" CornerRadius="9" Command="{Binding ToggleLanguageCommand}"
            AutomationProperties.Name="{Binding L[settings.language]}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <c:IconGlyph Icon="{x:Static app:Icons.Translate}" Size="14" Token="TextPrimary" />
        <TextBlock VerticalAlignment="Center" FontFamily="{Binding IsPersian, Converter={x:Static c:PresentationConverters.OtherLanguageFont}}" Text="{Binding OtherLanguageName}" />
      </StackPanel>
    </Button>
  </Grid>
</UserControl>
