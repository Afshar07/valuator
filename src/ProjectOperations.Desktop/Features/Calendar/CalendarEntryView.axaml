<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProjectOperations.Desktop.Features.Calendar"
             x:Class="ProjectOperations.Desktop.Features.Calendar.CalendarEntryView"
             x:DataType="vm:CalendarEntryViewModel">
  <UserControl.Styles>
    <Style Selector="Button.calendarEvent">
      <Setter Property="Background" Value="{DynamicResource BackgroundTrackBrush}" />
    </Style>
    <Style Selector="Button.calendarEvent.milestone">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.calendarEvent.overdue">
      <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}" />
    </Style>
  </UserControl.Styles>
  <Button Name="CalendarEvent" Classes="calendarEvent" Classes.milestone="{Binding IsMilestone}" Classes.overdue="{Binding IsOverdue}"
          Padding="5,2" MinHeight="0" CornerRadius="5" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
          Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding AccessibleName}">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
      <Border Classes="dot" Classes.milestone="{Binding IsMilestone}" Classes.overdue="{Binding IsOverdue}" />
      <TextBlock Grid.Column="1" Classes="Micro" FontWeight="Normal" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Text}" />
    </Grid>
  </Button>
</UserControl>
