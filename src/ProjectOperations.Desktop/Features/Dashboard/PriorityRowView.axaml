<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ProjectOperations.Desktop.Common"
             xmlns:vm="using:ProjectOperations.Desktop.Features.Dashboard"
             x:Class="ProjectOperations.Desktop.Features.Dashboard.PriorityRowView"
             x:DataType="vm:PriorityRowViewModel">
  <UserControl.Styles>
    <Style Selector="Run.when">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Run.when.late">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>
  <Border Classes="rule">
    <Button Name="PriorityRow" Classes="row" Padding="16,12" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding AccessibleName}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
        <c:InitialTile Text="{Binding Name}" Size="32" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
          <WrapPanel ItemSpacing="8">
            <TextBlock Classes="BodyStrong" Text="{Binding Name}" />
            <c:StagePill Stage="{Binding Stage}" />
          </WrapPanel>
          <TextBlock Classes="Small" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
            <Run Text="{Binding NextPrefix}" /><Run Classes="when" Classes.late="{Binding IsLate}" Text="{Binding NextWhen}" />
          </TextBlock>
        </StackPanel>
        <WrapPanel Grid.Column="2" ItemSpacing="4" LineSpacing="4" MaxWidth="190" VerticalAlignment="Center">
          <c:Pill Kind="Error" IsVisible="{Binding HasOverdue}" Text="{Binding OverdueText}" />
          <c:Pill Kind="Warning" IsVisible="{Binding HasWeek}" Text="{Binding WeekText}" />
          <c:Pill Kind="Neutral" Text="{Binding OpenText}" />
        </WrapPanel>
        <c:IconGlyph Grid.Column="3" Size="14" Token="TextTertiary" Icon="{Binding Caret}" />
      </Grid>
    </Button>
  </Border>
</UserControl>
