<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ProjectOperations.Desktop.Common"
             xmlns:app="using:ProjectOperations.Desktop"
             xmlns:vm="using:ProjectOperations.Desktop.Features.Tasks"
             x:Class="ProjectOperations.Desktop.Features.Tasks.MilestoneRowView"
             x:DataType="vm:MilestoneRowViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.BodyMedium.complete">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.Caption.relative">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.Caption.relative.complete">
      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>
  </UserControl.Styles>
  <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}">
    <Button Name="MilestoneRow" Classes="row" Padding="6,9" Command="{Binding EditCommand}" AutomationProperties.Name="{Binding AccessibleName}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <Panel VerticalAlignment="Top" Margin="0,2,0,0">
          <c:IconGlyph Icon="{x:Static app:Icons.Flag}" Size="16" Token="Accent" IsVisible="{Binding !IsComplete}" />
          <c:IconGlyph Icon="{x:Static app:Icons.FlagCheckered}" Weight="Fill" Size="16" Token="Success" IsVisible="{Binding IsComplete}" />
        </Panel>
        <StackPanel Grid.Column="1">
          <TextBlock Classes="BodyMedium" Classes.complete="{Binding IsComplete}" Text="{Binding Title}" />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Classes="Caption" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding DateText}" />
            <TextBlock Classes="Caption" Foreground="{DynamicResource TextSecondaryBrush}" Text="·" IsVisible="{Binding HasDate}" />
            <TextBlock Classes="Caption relative" Classes.complete="{Binding IsComplete}"
                       IsVisible="{Binding HasDate}" Text="{Binding RelativeText}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Button>
  </Border>
</UserControl>
