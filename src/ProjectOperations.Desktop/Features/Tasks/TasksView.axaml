<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ProjectOperations.Desktop.Common"
             xmlns:app="using:ProjectOperations.Desktop"
             xmlns:vm="using:ProjectOperations.Desktop.Features.Tasks"
             x:Class="ProjectOperations.Desktop.Features.Tasks.TasksView"
             x:DataType="vm:TasksViewModel">
  <StackPanel Spacing="16">
    <!-- Proposals the agent made that nobody reviewed yet. Dashed and violet: they are not committed tasks. -->
    <Panel Name="PendingProposalsBanner" IsVisible="{Binding HasPendingProposals}">
      <Border Background="{DynamicResource AiSoftBrush}" CornerRadius="10" Padding="14,10">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <c:IconGlyph Icon="{x:Static app:Icons.Sparkle}" Weight="Fill" Token="Ai" />
          <TextBlock Grid.Column="1" Classes="Small" VerticalAlignment="Center" Text="{Binding PendingProposalsText}" />
          <Button Grid.Column="2" Classes="ai" MinHeight="28" Content="{Binding L[tasks.review]}" Command="{Binding ReviewCommand}" />
        </Grid>
      </Border>
      <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="1" StrokeDashArray="4,3" Stroke="{DynamicResource AiBorderBrush}" IsHitTestVisible="False" />
    </Panel>

    <c:AdaptiveGrid Name="Columns" MinItemWidth="260">
      <Border Name="TasksCard" BorderThickness="1" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource BackgroundCardBrush}"
              BorderBrush="{DynamicResource BorderDefaultBrush}" BoxShadow="{DynamicResource CardShadow}">
        <StackPanel>
          <Border Padding="16,12,16,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="26">
              <TextBlock Classes="Heading" VerticalAlignment="Center" Text="{Binding L[tabs.tasks]}" />
              <Button Grid.Column="1" Name="NewTaskButton" Classes="primary" MinHeight="30" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Command="{Binding NewTaskCommand}" AutomationProperties.Name="{Binding L[task.new]}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:IconGlyph Icon="{x:Static app:Icons.Plus}" Weight="Bold" Size="14" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding L[task.new]}" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
          <StackPanel Name="TasksEmpty" Spacing="8" Margin="16,20,16,22" IsVisible="{Binding IsEmpty}">
            <c:IconGlyph Icon="{x:Static app:Icons.CheckSquareOffset}" Size="24" Token="TextTertiary" HorizontalAlignment="Left" />
            <TextBlock Classes="Body" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding L[v3.tasksEmpty]}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Groups}" />
        </StackPanel>
      </Border>

      <Border Name="MilestonesCard" Classes="sectionCard" BorderThickness="1" CornerRadius="12" Padding="16,14" Background="{DynamicResource BackgroundCardBrush}"
              BorderBrush="{DynamicResource BorderDefaultBrush}" BoxShadow="{DynamicResource CardShadow}">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="26" Margin="0,0,0,6">
            <TextBlock Classes="Heading" VerticalAlignment="Center" Text="{Binding L[milestones.title]}" />
            <Button Grid.Column="1" Name="NewMilestoneButton" MinHeight="30" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Command="{Binding NewMilestoneCommand}" AutomationProperties.Name="{Binding L[v3.newMs]}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:IconGlyph Icon="{x:Static app:Icons.Plus}" Size="14" />
                <TextBlock VerticalAlignment="Center" Text="{Binding L[v3.newMs]}" />
              </StackPanel>
            </Button>
          </Grid>
          <Border Name="MilestonesEmpty" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="0,10,0,8" IsVisible="{Binding !HasMilestones}">
            <TextBlock Classes="Small" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding L[v3.msEmpty]}" />
          </Border>
          <ItemsControl ItemsSource="{Binding Milestones}" />
        </StackPanel>
      </Border>
    </c:AdaptiveGrid>
  </StackPanel>
</UserControl>
