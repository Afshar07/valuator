<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProjectOperations.Desktop.Features.Tasks"
             x:Class="ProjectOperations.Desktop.Features.Tasks.TaskGroupView"
             x:DataType="vm:TaskGroupViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.MetaMedium.groupTitle">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.MetaMedium.groupTitle.overdue">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="TextBlock.MetaMedium.groupTitle.closed">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
  </UserControl.Styles>
  <StackPanel>
    <Border Padding="16,6" BorderThickness="0,1,0,0" Background="{DynamicResource BackgroundMutedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Classes="MetaMedium groupTitle" Classes.overdue="{Binding IsOverdue}" Classes.closed="{Binding IsClosed}"
                   FontWeight="SemiBold" Text="{Binding Title}" />
        <TextBlock Classes="MetaMedium" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Text="{Binding CountText}" />
      </StackPanel>
    </Border>
    <ItemsControl ItemsSource="{Binding Rows}" />
  </StackPanel>
</UserControl>
