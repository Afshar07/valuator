<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ProjectOperations.Desktop.Common"
             xmlns:app="using:ProjectOperations.Desktop"
             xmlns:vm="using:ProjectOperations.Desktop.Features.Tasks"
             x:Class="ProjectOperations.Desktop.Features.Tasks.TaskRowView"
             x:DataType="vm:TaskRowViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.title.inactive">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style Selector="TextBlock.title.cancelled">
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
    <Style Selector="TextBlock.due">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.due.inactive">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style Selector="TextBlock.due.overdue">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.relative">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.relative.overdue">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
  </UserControl.Styles>
  <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}">
    <Grid Name="TaskRow" ColumnDefinitions="Auto,*" Margin="8,0,10,0">
      <!-- Checkbox-style toggle: completes an open task, reopens a closed one. -->
      <Button Name="TaskToggle" Classes="icon" Width="32" Height="32" MinHeight="0" Padding="0" CornerRadius="7"
              Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding ToggleLabel}" ToolTip.Tip="{Binding ToggleLabel}">
        <c:IconGlyph Size="18" Icon="{Binding Status, Converter={x:Static vm:TaskStatusConverters.Icon}}"
                     Weight="{Binding Status, Converter={x:Static vm:TaskStatusConverters.Weight}}"
                     Token="{Binding Status, Converter={x:Static vm:TaskStatusConverters.Token}}" />
      </Button>
      <Button Grid.Column="1" Classes="row" Padding="6,10" Command="{Binding EditCommand}" AutomationProperties.Name="{Binding AccessibleName}">
        <Grid ColumnDefinitions="*,Auto,100" ColumnSpacing="12">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Classes="BodyMedium title" Classes.inactive="{Binding !IsActive}" Classes.cancelled="{Binding IsCancelled}" Text="{Binding Title}" />
            <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasRequirement}">
              <c:IconGlyph Icon="{x:Static app:Icons.ListChecks}" Size="12" Token="TextTertiary" />
              <TextBlock Classes="Meta" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding RequirementTitle}" />
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="1" IsVisible="{Binding IsInProgress}" CornerRadius="99" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                  Background="{DynamicResource AccentSoftBrush}">
            <TextBlock Classes="Micro" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding StatusText}" />
          </Border>
          <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Classes="Caption due" Classes.inactive="{Binding !IsActive}" Classes.overdue="{Binding IsOverdue}"
                       TextAlignment="End" TextWrapping="NoWrap" Text="{Binding DueText}" />
            <TextBlock Classes="Micro relative" Classes.overdue="{Binding IsOverdue}" TextAlignment="End" TextWrapping="NoWrap" Text="{Binding RelativeText}" />
          </StackPanel>
        </Grid>
      </Button>
    </Grid>
  </Border>
</UserControl>
