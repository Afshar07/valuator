<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ProjectOperations.Desktop.Common"
             xmlns:vm="using:ProjectOperations.Desktop.Features.Requirements"
             x:Class="ProjectOperations.Desktop.Features.Requirements.RequirementGroupView"
             x:DataType="vm:RequirementGroupViewModel">
  <Border Name="RequirementGroup" Classes="card">
    <StackPanel>
      <Button Name="RequirementGroupHeader" Classes="row" Padding="16,12" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding AccessibleName}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <c:IconGlyph Icon="{Binding CaretIcon}" Size="14" Token="TextTertiary" />
          <TextBlock Grid.Column="1" Classes="Heading" VerticalAlignment="Center" Text="{Binding Title}" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <c:ProgressTrack Width="64" Height="4" Value="{Binding Percent}" />
            <TextBlock Classes="Caption" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SummaryText}" />
          </StackPanel>
        </Grid>
      </Button>
      <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding IsExpanded}" />
    </StackPanel>
  </Border>
</UserControl>
