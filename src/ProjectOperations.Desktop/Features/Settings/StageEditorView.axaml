<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ProjectOperations.Desktop.Common"
             xmlns:app="using:ProjectOperations.Desktop"
             xmlns:vm="using:ProjectOperations.Desktop.Features.Settings"
             x:Class="ProjectOperations.Desktop.Features.Settings.StageEditorView"
             x:DataType="vm:StageEditorViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="SegmentTemplate" x:DataType="c:ChipOptionViewModel">
      <Button Classes="segment" Classes.selected="{Binding IsSelected}" Margin="1,0" Command="{Binding SelectCommand}"
              Content="{Binding Label}" AutomationProperties.Name="{Binding Label}" />
    </DataTemplate>
  </UserControl.Resources>
  <Border Classes="card" Padding="16,4">
    <StackPanel Name="StageEditor">
      <TextBlock Classes="Heading" Margin="0,12,0,4" Text="{Binding L[stages.title]}" />
      <TextBlock Classes="Small" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding L[stages.note]}" />
      <Border Name="StageTemplate" Classes="segmented" Margin="0,4,0,8">
        <ItemsControl ItemsSource="{Binding Templates.Options}" ItemTemplate="{StaticResource SegmentTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Border>
      <ItemsControl Name="StageRows" ItemsSource="{Binding Rows}" />
      <Button Name="AddStage" Classes="ghost" HorizontalAlignment="Left" Margin="0,10,0,12" Command="{Binding AddCommand}"
              AutomationProperties.Name="{Binding L[stages.add]}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:IconGlyph Icon="{x:Static app:Icons.Plus}" Size="14" />
          <TextBlock VerticalAlignment="Center" Text="{Binding L[stages.add]}" />
        </StackPanel>
      </Button>
    </StackPanel>
  </Border>
</UserControl>
