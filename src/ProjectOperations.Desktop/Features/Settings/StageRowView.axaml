<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ProjectOperations.Desktop.Common"
             xmlns:app="using:ProjectOperations.Desktop"
             xmlns:vm="using:ProjectOperations.Desktop.Features.Settings"
             x:Class="ProjectOperations.Desktop.Features.Settings.StageRowView"
             x:DataType="vm:StageRowViewModel">
  <Grid Name="StageRow" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,6,0,0">
    <!-- The swatch opens the colour picker; picking a colour closes it. -->
    <Button Name="StageColor" Classes="icon" Width="28" Height="28" MinHeight="28" Padding="0" VerticalAlignment="Center"
            Command="{Binding ToggleColorCommand}" AutomationProperties.Name="{Binding L[stages.color]}">
      <c:ColorSwatch Color="{Binding Color}" Size="18" />
    </Button>
    <Popup IsOpen="{Binding IsColorOpen, Mode=TwoWay}" PlacementTarget="{Binding #StageColor}" Placement="Bottom" IsLightDismissEnabled="True">
      <Border Classes="card" Padding="10">
        <ItemsControl Name="StageColorChoices" ItemsSource="{Binding Colors}" MaxWidth="170">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="6" LineSpacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Border>
    </Popup>

    <TextBox Grid.Column="1" Name="StageTitle" MinHeight="32" VerticalContentAlignment="Center" Text="{Binding Title, Mode=TwoWay}"
             AutomationProperties.Name="{Binding L[stages.name]}">
      <TextBox.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding CommitTitleCommand}" />
      </TextBox.KeyBindings>
    </TextBox>

    <TextBlock Grid.Column="2" Name="StageInUse" Classes="Caption" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
               IsVisible="{Binding IsInUse}" Text="{Binding InUseText}" ToolTip.Tip="{Binding L[stages.inUseWhy]}" />

    <Button Grid.Column="3" Name="StageUp" Classes="icon" Command="{Binding MoveUpCommand}"
            AutomationProperties.Name="{Binding L[stages.up]}" ToolTip.Tip="{Binding L[stages.up]}">
      <c:IconGlyph Icon="{x:Static app:Icons.CaretUp}" Size="15" />
    </Button>
    <Button Grid.Column="4" Name="StageDown" Classes="icon" Command="{Binding MoveDownCommand}"
            AutomationProperties.Name="{Binding L[stages.down]}" ToolTip.Tip="{Binding L[stages.down]}">
      <c:IconGlyph Icon="{x:Static app:Icons.CaretDown}" Size="15" />
    </Button>
    <Button Grid.Column="5" Name="StageDelete" Classes="icon" Command="{Binding DeleteCommand}"
            AutomationProperties.Name="{Binding L[stages.delete]}" ToolTip.Tip="{Binding DeleteTip}" ToolTip.ShowOnDisabled="True">
      <c:IconGlyph Icon="{x:Static app:Icons.Trash}" Size="15" />
    </Button>
  </Grid>
</UserControl>
