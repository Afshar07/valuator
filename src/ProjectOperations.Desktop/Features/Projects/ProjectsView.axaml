<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ProjectOperations.Desktop.Common"
             xmlns:app="using:ProjectOperations.Desktop"
             xmlns:vm="using:ProjectOperations.Desktop.Features.Projects"
             x:Class="ProjectOperations.Desktop.Features.Projects.ProjectsView"
             x:DataType="vm:ProjectsViewModel">
  <StackPanel Spacing="20">
    <c:PageHeader Title="{Binding L[navigation.projects]}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Width="220" Height="34" Padding="10,0" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center"
                Background="{DynamicResource BackgroundCardBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <c:IconGlyph Icon="{x:Static app:Icons.MagnifyingGlass}" Size="14" Token="TextTertiary" />
            <TextBox Name="ProjectFilter" Grid.Column="1" MinWidth="0" MinHeight="0" Padding="0" BorderThickness="0" Background="Transparent"
                     Text="{Binding Filter, Mode=TwoWay}" PlaceholderText="{Binding L[projects.filter]}" AutomationProperties.Name="{Binding L[projects.filter]}">
              <TextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
              </TextBox.Resources>
            </TextBox>
          </Grid>
        </Border>
        <Button Name="NewProjectButton" Classes="primary" MinHeight="34" Command="{Binding NewProjectCommand}" AutomationProperties.Name="{Binding L[project.new]}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:IconGlyph Icon="{x:Static app:Icons.Plus}" Weight="Bold" Size="14" />
            <TextBlock VerticalAlignment="Center" Text="{Binding L[project.new]}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </c:PageHeader>

    <Border Name="ProjectsCard" Classes="card">
      <StackPanel>
        <Border Padding="16,9" BorderThickness="0,0,0,1" Background="{DynamicResource BackgroundMutedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}">
          <c:TableGrid Columns="2*,1.3*,1.4*,1*,0.9*,90,30" CompactColumns="2*,1.4*,1*,90,30" ColumnSpacing="16">
            <TextBlock Classes="MetaMedium" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding L[project.column.project]}" />
            <TextBlock Grid.Column="1" c:TableGrid.CompactColumn="-1" Classes="MetaMedium" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding L[project.column.stage]}" />
            <TextBlock Grid.Column="2" c:TableGrid.CompactColumn="1" Classes="MetaMedium" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding L[project.column.readiness]}" />
            <TextBlock Grid.Column="3" c:TableGrid.CompactColumn="2" Classes="MetaMedium" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding L[project.column.next]}" />
            <TextBlock Grid.Column="4" c:TableGrid.CompactColumn="-1" Classes="MetaMedium" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding L[project.column.owner]}" />
            <TextBlock Grid.Column="5" c:TableGrid.CompactColumn="3" Classes="MetaMedium" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding L[project.column.status]}" />
          </c:TableGrid>
        </Border>
        <Border Padding="16,14" IsVisible="{Binding IsEmpty}">
          <TextBlock Classes="Body" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding L[dashboard.empty]}" />
        </Border>
        <ItemsControl ItemsSource="{Binding VisibleRows}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
