<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ProjectOperations.Desktop.Common"
             xmlns:app="using:ProjectOperations.Desktop"
             xmlns:vm="using:ProjectOperations.Desktop.Features.Projects"
             x:Class="ProjectOperations.Desktop.Features.Projects.ProjectRowView"
             x:DataType="vm:ProjectRowViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.Body.next">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.Body.next.overdue">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>
  <Border Classes="rule" Classes.first="{Binding IsFirst}">
    <!-- The delete button sits inside the row button: a button handles its own press, so the row does not also open the project. -->
    <Button Name="ProjectRow" Classes="row" Padding="16,12" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding AccessibleName}">
      <c:TableGrid Columns="2*,1.3*,1.4*,1*,0.9*,90,30" CompactColumns="2*,1.4*,1*,90,30" ColumnSpacing="16">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <c:InitialTile Text="{Binding Name}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Classes="BodyStrong" Text="{Binding Name}" />
            <TextBlock Classes="Caption" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding HasCompany}" Text="{Binding Company}" />
          </StackPanel>
        </Grid>
        <c:StagePill Grid.Column="1" c:TableGrid.CompactColumn="-1" Stage="{Binding Stage}" />
        <Grid Grid.Column="2" c:TableGrid.CompactColumn="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
          <c:ProgressTrack Value="{Binding ReadinessPercent}" />
          <TextBlock Grid.Column="1" Classes="Caption" Foreground="{DynamicResource TextSecondaryBrush}" MinWidth="40" TextWrapping="NoWrap"
                     FlowDirection="LeftToRight" TextAlignment="End" Text="{Binding ReadinessText}" />
        </Grid>
        <TextBlock Grid.Column="3" c:TableGrid.CompactColumn="2" Classes="Body next" Classes.overdue="{Binding IsNextOverdue}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Text="{Binding NextText}" />
        <TextBlock Grid.Column="4" c:TableGrid.CompactColumn="-1" Classes="Body" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Text="{Binding OwnerText}" />
        <c:Pill Grid.Column="5" c:TableGrid.CompactColumn="3" Text="{Binding StatusText}" Kind="{Binding StatusKind}" />
        <Button Grid.Column="6" c:TableGrid.CompactColumn="4" Name="DeleteProjectButton" Classes="dangerGhost" Width="30" Height="30" MinHeight="30" Padding="0"
                HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Command="{Binding DeleteCommand}" AutomationProperties.Name="{Binding L[v3.delProject]}" ToolTip.Tip="{Binding L[v3.delProject]}">
          <c:IconGlyph Icon="{x:Static app:Icons.Trash}" Size="15" />
        </Button>
      </c:TableGrid>
    </Button>
  </Border>
</UserControl>
