<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ProjectOperations.Desktop.Common"
             xmlns:app="using:ProjectOperations.Desktop"
             xmlns:vm="using:ProjectOperations.Desktop.Features.Projects"
             x:Class="ProjectOperations.Desktop.Features.Projects.DeleteProjectDialogView"
             x:DataType="vm:DeleteProjectDialogViewModel">
  <c:DialogChrome Name="DeleteProjectDialog" Title="{Binding Heading}" CloseCommand="{Binding CancelCommand}" CloseLabel="{Binding L[action.close]}">
    <StackPanel>
      <TextBlock Classes="Body" Margin="18,12,18,18" Text="{Binding Body}" />
      <Border Classes="dialogFooter">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <Button Grid.Column="1" Name="CancelDeleteProjectButton" HorizontalAlignment="Left" Content="{Binding L[action.cancel]}" Command="{Binding CancelCommand}" />
          <Button Grid.Column="2" Name="ConfirmDeleteProjectButton" Classes="danger" HorizontalAlignment="Left" Command="{Binding ConfirmCommand}"
                  AutomationProperties.Name="{Binding L[v3.delProject]}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconGlyph Icon="{x:Static app:Icons.Trash}" Size="14" />
              <TextBlock VerticalAlignment="Center" Text="{Binding L[v3.delProject]}" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </StackPanel>
  </c:DialogChrome>
</UserControl>
