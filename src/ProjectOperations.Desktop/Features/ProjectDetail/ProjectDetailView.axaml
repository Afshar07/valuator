<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ProjectOperations.Desktop.Common"
             xmlns:app="using:ProjectOperations.Desktop"
             xmlns:vm="using:ProjectOperations.Desktop.Features.ProjectDetail"
             x:Class="ProjectOperations.Desktop.Features.ProjectDetail.ProjectDetailView"
             x:DataType="vm:ProjectDetailViewModel">
  <StackPanel Spacing="16">
    <StackPanel Name="ProjectHeader" Spacing="10">
      <Button Name="BackToProjects" Classes="link" HorizontalAlignment="Left" Command="{Binding BackCommand}" AutomationProperties.Name="{Binding BackText}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:IconGlyph Icon="{Binding BackIcon}" Size="14" />
          <TextBlock VerticalAlignment="Center" Text="{Binding BackText}" />
        </StackPanel>
      </Button>

      <!-- Identity on the start side; readiness and the assistant toggle on the end side, dropping below together when narrow. -->
      <Grid Name="HeaderRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
        <StackPanel Name="Identity" Spacing="4" VerticalAlignment="Bottom">
          <StackPanel Name="TitleLine" Orientation="Horizontal" Spacing="10">
            <TextBlock Name="ProjectTitle" Classes="Title" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
            <c:StagePill Name="StagePill" Stage="{Binding Stage}" />
            <c:Pill IsVisible="{Binding ShowStatus}" Text="{Binding StatusText}" Kind="Neutral" />
            <Button Name="EditProjectButton" Classes="square" Width="30" Height="30" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                    Command="{Binding EditCommand}" AutomationProperties.Name="{Binding L[v3.editProject]}" ToolTip.Tip="{Binding L[v3.editProject]}">
              <c:IconGlyph Icon="{x:Static app:Icons.PencilSimple}" Size="15" />
            </Button>
          </StackPanel>
          <TextBlock Classes="Body" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Subtitle}" />
        </StackPanel>

        <StackPanel Name="HeaderEnd" Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Bottom">
          <StackPanel Name="ReadinessSummary" Spacing="6" Width="220" VerticalAlignment="Center">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="Caption" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding L[project.column.readiness]}" />
              <TextBlock Name="ReadinessRatio" Grid.Column="1" Classes="CaptionMedium" FontWeight="SemiBold" TextWrapping="NoWrap"
                         ToolTip.Tip="{Binding ReadinessTip}" Text="{Binding ReadinessText}" />
            </Grid>
            <c:ProgressTrack Height="6" Value="{Binding ReadinessPercent}" />
          </StackPanel>
          <Button Name="AssistantToggle" Classes="ai" MinHeight="34" HorizontalAlignment="Left" Command="{Binding ToggleAssistantCommand}"
                  AutomationProperties.Name="{Binding L[agent.assistant]}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconGlyph Icon="{x:Static app:Icons.Sparkle}" Size="14" />
              <TextBlock VerticalAlignment="Center" Text="{Binding L[agent.assistant]}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </StackPanel>

    <!-- The tab strip's baseline rule sits behind the selected underline. -->
    <Panel>
      <Border Height="1" VerticalAlignment="Top" Margin="0,35,0,0" Background="{DynamicResource BorderDefaultBrush}" />
      <TabControl Name="ProjectTabs" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}">
        <TabItem Header="{Binding L[tabs.overview]}" IsEnabled="{Binding !IsLocked}">
          <ContentControl Content="{Binding Overview}" />
        </TabItem>
        <TabItem Header="{Binding L[tabs.requirements]}" IsEnabled="{Binding !IsLocked}">
          <ContentControl Content="{Binding Requirements}" />
        </TabItem>
        <TabItem Header="{Binding L[tabs.tasks]}" IsEnabled="{Binding !IsLocked}">
          <ContentControl Content="{Binding Tasks}" />
        </TabItem>
        <TabItem Header="{Binding L[tabs.delegate]}" IsEnabled="{Binding !IsLocked}">
          <ContentControl Content="{Binding Delegation}" />
        </TabItem>
      </TabControl>
    </Panel>
  </StackPanel>
</UserControl>
