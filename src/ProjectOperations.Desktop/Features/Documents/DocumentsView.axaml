<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ProjectOperations.Desktop.Common"
             xmlns:app="using:ProjectOperations.Desktop"
             xmlns:vm="using:ProjectOperations.Desktop.Features.Documents"
             x:Class="ProjectOperations.Desktop.Features.Documents.DocumentsView"
             x:DataType="vm:DocumentsViewModel">
  <StackPanel Spacing="20">
    <c:PageHeader Title="{Binding L[documents.title]}" Subtitle="{Binding L[documents.subtitle]}" />

    <ItemsControl Name="DocumentFilters" IsVisible="{Binding HasDocuments}" ItemsSource="{Binding Filter.Options}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel ItemSpacing="6" LineSpacing="6" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>

    <Border Name="DocumentsEmpty" Classes="card" Padding="16,14" IsVisible="{Binding IsEmpty}">
      <StackPanel Spacing="6">
        <TextBlock Classes="BodyMedium" Text="{Binding L[documents.empty]}" />
        <TextBlock Classes="Small" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding L[documents.emptyHint]}" />
      </StackPanel>
    </Border>

    <c:AdaptiveGrid MinItemWidth="340" IsVisible="{Binding HasDocuments}">
      <Border Name="DocumentList" Classes="card">
        <ItemsControl ItemsSource="{Binding Rows}" />
      </Border>
      <ContentControl Content="{Binding Detail}" IsVisible="{Binding HasDetail}" />
    </c:AdaptiveGrid>
  </StackPanel>
</UserControl>
