<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ProjectOperations.Desktop.Common"
             xmlns:app="using:ProjectOperations.Desktop"
             xmlns:vm="using:ProjectOperations.Desktop.Features.Documents"
             x:Class="ProjectOperations.Desktop.Features.Documents.DocumentDetailView"
             x:DataType="vm:DocumentDetailViewModel">
  <Border Name="DocumentDetail" Classes="card" Padding="16">
    <StackPanel Spacing="14">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Border Width="40" Height="40" CornerRadius="10" VerticalAlignment="Center" Background="{DynamicResource BackgroundTrackBrush}">
          <c:IconGlyph Icon="{Binding Icon}" Size="21" Token="TextSecondary" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Classes="BodyStrong" FontSize="14" FlowDirection="LeftToRight" HorizontalAlignment="Left" Text="{Binding FileName}" />
          <TextBlock Name="DocumentPath" Classes="Caption" Foreground="{DynamicResource TextTertiaryBrush}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Text="{Binding Path}" />
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="6">
        <TextBlock Classes="Small" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding L[documents.linkedTo]}" />
        <TextBlock Grid.Column="1" Classes="Small" Text="{Binding LinkedTo}" />
        <TextBlock Grid.Row="1" Classes="Small" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding L[documents.added]}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Classes="Small" Text="{Binding AddedText}" />
      </Grid>

      <WrapPanel ItemSpacing="6" LineSpacing="6">
        <Button Name="OpenDocumentButton" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding L[documents.open]}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:IconGlyph Icon="{x:Static app:Icons.ArrowSquareOut}" Size="14" />
            <TextBlock VerticalAlignment="Center" Text="{Binding L[documents.open]}" />
          </StackPanel>
        </Button>
        <Button Name="RevealDocumentButton" Command="{Binding RevealCommand}" AutomationProperties.Name="{Binding L[documents.reveal]}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:IconGlyph Icon="{x:Static app:Icons.FolderOpen}" Size="14" />
            <TextBlock VerticalAlignment="Center" Text="{Binding L[documents.reveal]}" />
          </StackPanel>
        </Button>
        <Button Name="UnlinkDocumentButton" Classes="ghost" Command="{Binding UnlinkCommand}" AutomationProperties.Name="{Binding L[documents.unlink]}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:IconGlyph Icon="{x:Static app:Icons.LinkBreak}" Size="14" />
            <TextBlock VerticalAlignment="Center" Text="{Binding L[documents.unlink]}" />
          </StackPanel>
        </Button>
      </WrapPanel>

      <!-- Files are never read, so there is nothing to preview. -->
      <Panel>
        <Border CornerRadius="10" Padding="18,28" Background="{DynamicResource BackgroundMutedBrush}">
          <StackPanel Spacing="6">
            <c:IconGlyph Icon="{x:Static app:Icons.FileDashed}" Size="26" Token="TextTertiary" HorizontalAlignment="Left" />
            <TextBlock Classes="BodyStrong" Text="{Binding L[documents.previewUnavailable]}" />
            <TextBlock Classes="Small" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding L[documents.previewUnavailableBody]}" />
          </StackPanel>
        </Border>
        <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="1" StrokeDashArray="4,3" Stroke="{DynamicResource BorderDefaultBrush}" IsHitTestVisible="False" />
      </Panel>
    </StackPanel>
  </Border>
</UserControl>
