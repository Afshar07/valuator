<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ProjectOperations.Desktop.Common"
             xmlns:app="using:ProjectOperations.Desktop"
             xmlns:vm="using:ProjectOperations.Desktop.Features.Overview"
             x:Class="ProjectOperations.Desktop.Features.Overview.StateListView"
             x:DataType="vm:StateListViewModel">
  <Border Classes="card" Padding="16,14">
    <StackPanel>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="26" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Classes="Heading" VerticalAlignment="Center" Text="{Binding Title}" />
          <TextBlock Classes="MetaMedium" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding CountText}" />
        </StackPanel>
        <Button Grid.Column="1" Name="AddStateItem" VerticalAlignment="Center" MinHeight="26" Padding="9,0" FontSize="12" HorizontalAlignment="Left"
                Command="{Binding StartAddCommand}" AutomationProperties.Name="{Binding L[overview.add]}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:IconGlyph Icon="{x:Static app:Icons.Plus}" Size="14" />
            <TextBlock VerticalAlignment="Center" Text="{Binding L[overview.add]}" />
          </StackPanel>
        </Button>
      </Grid>
      <TextBlock Classes="Body" Foreground="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding IsEmpty}" Text="{Binding L[date.notSet]}" />
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StateItem">
            <Border Classes="rule" Padding="0,7">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <c:IconGlyph Icon="{Binding Icon}" Size="15" Token="TextTertiary" VerticalAlignment="Top" Margin="0,2,0,0" />
                <TextBlock Grid.Column="1" Classes="Body" Text="{Binding Text}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Spacing="8" Margin="0,10,0,0" IsVisible="{Binding IsAdding}">
        <TextBox Name="StateItemInput" MinHeight="34" Text="{Binding NewText, Mode=TwoWay}" PlaceholderText="{Binding Title}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="primary" Content="{Binding L[overview.addSave]}" Command="{Binding SaveCommand}" />
          <Button Content="{Binding L[action.cancel]}" Command="{Binding CancelCommand}" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
